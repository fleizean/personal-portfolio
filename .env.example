# Sunucuda /opt/personal-portfolio/.env olarak tutulur. Gerçek değerler ASLA commit edilmez.

# nginx'in proxy yaptığı yerel port (web servisi)
WEB_PORT=8083

POSTGRES_USER=portfolio
POSTGRES_DB=portfolio
# Bağlantı cümlesini bozmaması için yalnızca hex karakter kullanın:
#   openssl rand -hex 32
POSTGRES_PASSWORD=
