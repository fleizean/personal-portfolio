# Sunucuda /opt/personal-portfolio/.env olarak tutulur. Gerçek değerler ASLA commit edilmez.

# nginx'in proxy yaptığı yerel portlar
WEB_PORT=8083
API_PORT=8086

POSTGRES_USER=portfolio
POSTGRES_DB=portfolio
# Bağlantı cümlesini bozmaması için yalnızca hex karakter kullanın:
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# Yönetim paneli girişi (GitHub OAuth App: Settings > Developer settings > OAuth Apps)
#   Callback URL: https://fleizean.dev/api/auth/github/callback
# Boş bırakılırsa site çalışır, yalnızca yönetim girişi kapalı olur.
ADMIN_GITHUB_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
