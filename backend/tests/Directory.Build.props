<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <!-- Test adları okunabilirlik için alt çizgiyle yazılır (Returns_seeded_content gibi) -->
