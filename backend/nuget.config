<?xml version="1.0" encoding="utf-8"?>
<!-- Paketler yalnızca nuget.org'dan gelir; makinedeki başka kaynaklar karışmaz -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
