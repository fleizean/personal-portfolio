<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\Core\Portfolio.Application\Portfolio.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>
  <ItemGroup>
    <!-- İlk kurulumda veritabanına yüklenen içerik. Dosya adındaki .tr/.en kültür eki sanılıp
         ayrı uydu derlemeye konmasın diye kültür algılaması kapalı ve kaynak adı sabit. -->
    <EmbeddedResource Include="Seed\content.*.json"
                      WithCulture="false"
                      LogicalName="Portfolio.Persistence.Seed.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
